{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ]
    },
    "//#quality": {
      "dependsOn": [
        "//#lint",
        "//#format"
      ]
    },
    "//#quality:fix": {
      "dependsOn": [
        "//#lint:fix",
        "//#format:fix"
      ]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": [
        "//#lint:fix"
      ],
      "cache": false
    },
    "//#typecheck": {}
  }
}