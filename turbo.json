{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!README.md"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "generate:schemas": {},
    "check:schemas": {},
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "//#lint": {
      "dependsOn": ["@shipworthy/overlay#generate:schemas"]
    },
    "//#lint:fix": {
      "cache": false,
      "dependsOn": ["@shipworthy/overlay#generate:schemas"]
    },
    "//#format": {
      "dependsOn": ["@shipworthy/overlay#generate:schemas"]
    },
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "//#typecheck": {
      "dependsOn": ["@shipworthy/overlay#generate:schemas"]
    },
    "bundle": {},
    "generate": {}
  }
}
