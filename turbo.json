{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "generate:schemas": {},
    "check:schemas": {},
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "//#typecheck": {},
    "release": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "GITHUB_*",
        "ACTIONS_ID_TOKEN_REQUEST_URL",
        "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
        "NODE_AUTH_TOKEN",
        "NPM_CONFIG_*",
        "npm_config_*"
      ]
    },
    "bundle": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
