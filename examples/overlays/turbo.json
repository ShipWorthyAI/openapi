{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "dependsOn": ["^transit"],
      "inputs": ["openapi/**", "overlays/**", "package.json"],
      "outputs": ["generated/**"]
    },
    "test": {
      "dependsOn": ["transit", "generate"]
    }
  }
}
