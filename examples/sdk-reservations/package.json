{
  "name": "@shipworthy/example-sdk-reservations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./zod-schema": "./src/generated/reservations/zod-schema.ts",
    "./standard-schema": "./src/generated/reservations/standard-schema.ts"
  },
  "scripts": {
    "generate": "openapi generate tanstack-query openapi.json -o src/generated --name reservations && openapi generate zod openapi.json -o src/generated/reservations/zod-schema.ts && openapi generate standard-schema openapi.json -o src/generated/reservations/standard-schema.ts"
  },
  "dependencies": {
    "@shipworthy/openapi-tanstack-query": "workspace:*",
    "effect": "catalog:",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@shipworthy/openapi-cli": "workspace:*",
    "@shipworthy/openapi-standard-schema": "workspace:*",
    "@shipworthy/openapi-typescript": "workspace:*",
    "@shipworthy/openapi-zod": "workspace:*",
    "@shipworthy/typescript-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "react": "^18.0.0 || ^19.0.0"
  }
}
