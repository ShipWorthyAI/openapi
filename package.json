{
  "name": "@shipworthy/openapi",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "examples/*",
      "!examples/commonjs-typescript-5",
      "!examples/esm-typescript-7",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-node": "4.0.0",
      "@effect/platform-node-shared": "4.0.0",
      "@effect/tsgo": "0.51.1",
      "@effect/vitest": "4.0.0",
      "@tanstack/react-query": "^5.104.1",
      "@types/node": "^24.10.3",
      "@types/react": "^19.0.0",
      "effect": "4.0.0",
      "oxfmt": "^0.72.0",
      "oxlint": "^1.87.0",
      "oxlint-tsgolint": "7.0.2003",
      "react": "^19.0.0",
      "tsdown": "0.23.0",
      "turbo": "2.11.7",
      "typescript": "^7.0.2",
      "vite": "^8.0.0",
      "vitest": "5.0.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "fix": "turbo run quality:fix",
    "check": "turbo run quality test",
    "typecheck": "oxlint --type-aware --type-check .",
    "examples:bundle": "turbo run bundle --filter='./examples/*'",
    "examples:generate": "turbo run generate --filter='./examples/*'",
    "prepare": "lefthook install && effect-tsgo patch --oxlint",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install && bun run check",
    "release": "bun run release:verify --integrity-only && changeset publish --from-pack-dir .release",
    "release:local": "bun run check && bun run build && bun run release:pack && bun run release:verify",
    "release:pack": "release-artifacts pack",
    "release:verify": "release-artifacts verify"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "catalog:",
    "@shipworthy/oxlint-plugin": "workspace:*",
    "@shipworthy/publisher": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "effect": "catalog:",
    "lefthook": "2.1.16",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
