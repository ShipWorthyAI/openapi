{
  "name": "@shipworthy/openapi-tanstack-query",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipWorthyAI/openapi.git",
    "directory": "packages/openapi-tanstack-query"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generator": "./src/generator.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./generator": {
        "types": "./dist/generator.d.ts",
        "default": "./dist/generator.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bunx turbo run prepare:pack",
    "postpack": "bun run publish-manifest postpack",
    "prepare:pack": "bun run publish-manifest prepack",
    "release": "bun run publish-package"
  },
  "dependencies": {
    "@shipworthy/openapi-fetch": "workspace:*",
    "@shipworthy/openapi-transformer": "workspace:*"
  },
  "devDependencies": {
    "@shipworthy/openapi-generator": "workspace:*",
    "@shipworthy/publisher": "workspace:*",
    "@shipworthy/typescript-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@shipworthy/openapi-generator": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "effect": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@shipworthy/openapi-generator": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  }
}
