{
  "name": "@shipworthy/openapi-fetch",
  "version": "0.0.1",
  "description": "Fast, type-safe fetch client for your OpenAPI schema. Only 6 kb (min). Works with React, Vue, Svelte, or vanilla JS.",
  "keywords": [
    "api",
    "fetch",
    "oapi_3",
    "oapi_3_1",
    "openapi",
    "react",
    "rest",
    "svelte",
    "swagger",
    "typescript",
    "vue"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "version": "bun run build"
  },
  "devDependencies": {
    "@shipworthy/openapi-typescript": "workspace:^",
    "axios": "1.16.0",
    "express": "5.2.1",
    "feature-fetch": "0.0.55",
    "node-forge": "1.4.0",
    "openapi-typescript-codegen": "0.30.0",
    "openapi-typescript-fetch": "2.2.1",
    "superagent": "10.3.0",
    "typescript": "catalog:",
    "undici": "7.25.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
