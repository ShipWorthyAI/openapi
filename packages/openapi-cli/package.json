{
  "name": "@shipworthy/openapi-cli",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipWorthyAI/openapi.git",
    "directory": "packages/openapi-cli"
  },
  "bin": {
    "openapi": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/cli.ts"
  },
  "publishConfig": {
    "bin": {
      "openapi": "./dist/bin.js"
    },
    "main": "./dist/cli.js",
    "types": "./dist/cli.d.ts",
    "exports": {
      ".": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && sed -i.bak '1s|^#!.*|#!/usr/bin/env node|' dist/bin.js && rm dist/bin.js.bak"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@shipworthy/openapi-generator": "workspace:*",
    "@shipworthy/openapi-overlay": "workspace:*",
    "@shipworthy/openapi-parser": "workspace:*",
    "@shipworthy/openapi-validator": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@shipworthy/openapi-standard-schema": "workspace:*",
    "@shipworthy/openapi-tanstack-query": "workspace:*",
    "@shipworthy/openapi-typescript": "workspace:*",
    "@shipworthy/openapi-zod": "workspace:*",
    "@shipworthy/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@shipworthy/openapi-standard-schema": "workspace:*",
    "@shipworthy/openapi-tanstack-query": "workspace:*",
    "@shipworthy/openapi-typescript": "workspace:*",
    "@shipworthy/openapi-zod": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@shipworthy/openapi-standard-schema": {
      "optional": true
    },
    "@shipworthy/openapi-tanstack-query": {
      "optional": true
    },
    "@shipworthy/openapi-typescript": {
      "optional": true
    },
    "@shipworthy/openapi-zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
