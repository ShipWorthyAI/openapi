{
  "name": "@shipworthy/openapi-typescript",
  "version": "1.0.1",
  "description": "Convert OpenAPI 3.0 & 3.1 schemas to TypeScript",
  "keywords": [
    "codegen",
    "dts",
    "generation",
    "node",
    "openapi",
    "openapi 3",
    "swagger",
    "ts",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipWorthyAI/openapi.git",
    "directory": "packages/openapi-typescript"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#compiler": "./src/compiler.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./compiler": "./src/compiler.ts",
    "./case-mapping": "./src/generation/casing/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "imports": {
      "#compiler": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.js"
      }
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./compiler": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.js"
      },
      "./case-mapping": {
        "types": "./dist/case-mapping.d.ts",
        "default": "./dist/case-mapping.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "test": "vitest run",
    "version": "bunx turbo run build"
  },
  "dependencies": {
    "@shipworthy/openapi-generator": "workspace:*",
    "@shipworthy/openapi-transformer": "workspace:*",
    "effect": "catalog:",
    "oxfmt": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
