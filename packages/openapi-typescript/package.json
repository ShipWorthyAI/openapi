{
  "name": "@shipworthy/openapi-typescript",
  "version": "0.0.1",
  "description": "Convert OpenAPI 3.0 & 3.1 schemas to TypeScript",
  "keywords": [
    "codegen",
    "dts",
    "generation",
    "node",
    "openapi",
    "openapi 3",
    "swagger",
    "ts",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "imports": {
    "#compiler": "./src/compiler.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./compiler": "./src/compiler.ts"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:exports": "bun run build && attw --pack .",
    "prepublish": "bun run build",
    "version": "bun run build"
  },
  "dependencies": {
    "@shipworthy/openapi-generator": "workspace:*",
    "@shipworthy/openapi-transformer": "workspace:*",
    "change-case": "^5.4.4",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^7.0.0"
  }
}
