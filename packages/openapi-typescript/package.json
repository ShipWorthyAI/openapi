{
  "name": "@shipworthy/openapi-typescript",
  "version": "0.0.1",
  "description": "Convert OpenAPI 3.0 & 3.1 schemas to TypeScript",
  "keywords": [
    "codegen",
    "dts",
    "generation",
    "node",
    "openapi",
    "openapi 3",
    "swagger",
    "ts",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "imports": {
    "#compiler": "./src/compiler.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./compiler": "./src/compiler.ts"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "tsc -p tsconfig.build.json --watch",
    "download:schemas": "bun ./scripts/download-schemas.ts",
    "prepack": "bun run build",
    "test": "bun run test:js && bun run test:examples && bun run test:exports",
    "test:js": "vitest run",
    "test:exports": "bun run build && attw --pack .",
    "test:examples": "tsc -p tsconfig.examples.json --noEmit",
    "update:examples": "bun run build && bun run download:schemas && bun ./scripts/update-examples.ts",
    "prepublish": "bun run build",
    "version": "bun run build"
  },
  "dependencies": {
    "@shipworthy/openapi-core": "workspace:*",
    "@shipworthy/json-schema-ref-parser": "workspace:*",
    "ansi-colors": "^4.1.3",
    "change-case": "^5.4.4",
    "parse-json": "^8.3.0",
    "supports-color": "^10.2.2",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/degit": "2.8.6",
    "@types/js-yaml": "4.0.9",
    "degit": "2.8.4",
    "execa": "^9.6.0",
    "strip-ansi": "7.2.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.0"
  }
}
