{
  "name": "@shipworthy/openapi-overlay",
  "version": "1.0.1",
  "description": "Apply versioned OpenAPI Overlay documents with Effect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipWorthyAI/openapi.git",
    "directory": "packages/openapi-overlay"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/1.0": "./src/schemas/1.0.ts",
    "./schemas/1.1": "./src/schemas/1.1.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./schemas/1.0": {
        "types": "./dist/schemas/1.0.d.ts",
        "default": "./dist/schemas/1.0.js"
      },
      "./schemas/1.1": {
        "types": "./dist/schemas/1.1.d.ts",
        "default": "./dist/schemas/1.1.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "generate:schemas": "bun scripts/generate-schemas.ts",
    "check:schemas": "bun scripts/generate-schemas.ts --check",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@shipworthy/openapi-parser": "workspace:*",
    "effect": "catalog:",
    "jsonpath-rfc9535": "1.3.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@shipworthy/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
