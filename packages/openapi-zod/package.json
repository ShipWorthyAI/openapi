{
  "name": "@shipworthy/openapi-zod",
  "version": "0.0.2",
  "description": "Generate Zod validators from OpenAPI 3.1 schemas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipWorthyAI/openapi.git",
    "directory": "packages/openapi-zod"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "test": "bun test --timeout 30000 test/generate.test.ts test/cli.test.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@shipworthy/openapi-generator": "workspace:*",
    "@shipworthy/openapi-transformer": "workspace:*",
    "@shipworthy/openapi-typescript": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@shipworthy/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
