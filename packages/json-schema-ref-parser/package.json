{
  "name": "@shipworthy/json-schema-ref-parser",
  "version": "0.0.1",
  "description": "Parse, Resolve, and Dereference JSON Schema $ref pointers",
  "keywords": [
    "$ref",
    "dereference",
    "json",
    "json-pointer",
    "json-schema",
    "jsonschema",
    "resolve",
    "schema"
  ],
  "homepage": "https://apidevtools.com/json-schema-ref-parser/",
  "license": "MIT",
  "author": {
    "name": "JonLuca DeCaro",
    "email": "apis@jonlu.ca",
    "url": "https://jonlu.ca"
  },
  "contributors": [
    {
      "name": "Boris Cherny",
      "email": "boris@performancejs.com"
    },
    {
      "name": "Phil Sturgeon",
      "email": "phil@apisyouwonthate.com"
    },
    {
      "name": "Jakub Rożek",
      "email": "jakub@stoplight.io"
    },
    {
      "name": "James Messinger",
      "url": "https://jamesmessinger.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/APIDevTools/json-schema-ref-parser.git"
  },
  "files": [
    "lib",
    "dist"
  ],
  "type": "module",
  "main": "./lib/index.ts",
  "module": "./lib/index.ts",
  "browser": {
    "fs": false
  },
  "types": "./lib/index.ts",
  "exports": {
    ".": "./lib/index.ts"
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "rimraf dist && tsc",
    "test": "vitest --coverage",
    "test:specific": "vitest invalid",
    "test:node": "bun run test",
    "test:browser": "node ./test/fixtures/run-browser-tests.mjs",
    "test:update": "vitest -u",
    "test:watch": "vitest -w"
  },
  "dependencies": {
    "effect": "catalog:",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@types/json-schema": "^7.0.15"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
